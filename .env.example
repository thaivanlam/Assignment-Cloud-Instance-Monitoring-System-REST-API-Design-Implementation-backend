# Copy to .env (or export in your shell) and adjust as needed

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database (SQLite file by default; use sqlite:///:memory: for in-memory)
DATABASE_URL=sqlite:///./monitoring.db

# LLM API (optional — the /diagnosis endpoint falls back to a rule-based
# diagnosis when no key is configured)
ANTHROPIC_API_KEY=

# Shared short-lived state: login counters, revoked tokens, cached diagnoses.
# Empty keeps it in process memory — correct for ONE worker only. Set it for
# `uvicorn --workers N`, several servers, or serverless.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=techvalley:

# Login rate limit: failed attempts per window, per account and per client address
LOGIN_MAX_FAILURES_PER_ACCOUNT=10
LOGIN_MAX_FAILURES_PER_IP=50
LOGIN_WINDOW_SECONDS=900

# Seconds an LLM diagnosis is reused for an unchanged instance; 0 disables the cache
DIAGNOSIS_CACHE_TTL_SECONDS=1800
